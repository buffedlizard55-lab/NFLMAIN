# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtualenvs (the pipeline itself is stdlib-only; this is for pytest)
.venv/
venv/
env/

# Local upstream download cache - never commit fetched payloads
.cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# NOTE: docs/data/ is deliberately NOT ignored. It is generated by the pipeline and
# committed so GitHub Pages can serve it as a static site. It must never be hand-edited.
